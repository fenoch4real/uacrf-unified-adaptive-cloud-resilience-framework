{
  "realm": "uacrf",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "uacrf-ux01",
      "name": "UACRF UX01 local",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8084/*"
      ],
      "webOrigins": [
        "http://localhost:8084"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "uacrf-s01-context"
      ]
    },
    {
      "clientId": "uacrf-s03-publisher",
      "name": "UACRF S03 outbox publisher",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_S03_PUBLISHER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "uacrf-s01-context"
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "uacrf-s01-directory",
      "name": "UACRF S01 directory reader",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_DIRECTORY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "uacrf-directory-roles",
        "kc-admin-api"
      ],
      "fullScopeAllowed": false
    }
  ],
  "clientScopes": [
    {
      "name": "profile",
      "description": "OpenID Connect profile scope for the local browser experience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "uacrf-s01-context",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "s01-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "uacrf-s01",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "s01-subject-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "local-tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "local-dev",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "local-environment-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "environment_id",
            "claim.value": "local",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "uacrf-directory-roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "kc-admin-api",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "admin api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-admin-api-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "local-admin",
      "enabled": true,
      "email": "local-admin@example.invalid",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_LOCAL_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "username": "local-approver",
      "enabled": true,
      "email": "local-approver@example.invalid",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Approver",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_LOCAL_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "username": "local-member",
      "enabled": true,
      "email": "local-member@example.invalid",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Member",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_LOCAL_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-4000-8000-0000000000d2",
      "username": "service-account-uacrf-s03-publisher",
      "enabled": true,
      "serviceAccountClientId": "uacrf-s03-publisher"
    },
    {
      "id": "00000000-0000-4000-8000-0000000000d1",
      "username": "service-account-uacrf-s01-directory",
      "enabled": true,
      "serviceAccountClientId": "uacrf-s01-directory",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    }
  ],
  "scopeMappings": [],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "uacrf-s01-directory",
        "roles": [
          "view-users"
        ]
      }
    ]
  }
}
