{
  "openapi": "3.1.0",
  "info": {
    "title": "UACRF evidence observation read support",
    "version": "1.0",
    "description": "Supporting read operation for the canonical evidence admission workflow; raw observation access is not qualification."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/evidence/events/{id}": {
      "get": {
        "operationId": "readEvidenceObservation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized retained observation; no qualification asserted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "service_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "source_event_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "schema_version": {
                      "enum": [
                        "UACRF_OBSERVATION_V1",
                        "UACRF_OBSERVATION_V2"
                      ]
                    },
                    "occurred_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "received_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "artifact_verified_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "object_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "quality": {
                      "const": "OBSERVATION_ONLY"
                    },
                    "observation": {
                      "$ref": "../runtime/src/main/resources/contracts/evidence-observation.schema.json"
                    }
                  },
                  "required": [
                    "id",
                    "service_id",
                    "source_id",
                    "source_event_id",
                    "schema_version",
                    "occurred_at",
                    "received_at",
                    "expires_at",
                    "artifact_verified_at",
                    "object_ref",
                    "digest",
                    "quality",
                    "observation"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request was not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The request was not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The request was not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The request was not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The request was not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The request was not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The request was not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evidence/events": {
      "get": {
        "operationId": "evidence-list",
        "summary": "evidence list",
        "parameters": [
          {
            "in": "query",
            "name": "service_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "enum": [
                "METRIC",
                "CONFIGURATION",
                "AGENT_EXECUTION"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized projection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 200,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "\\S"
                          },
                          "service_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "\\S"
                          },
                          "source_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "\\S"
                          },
                          "source_event_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "\\S"
                          },
                          "schema_version": {
                            "enum": [
                              "UACRF_OBSERVATION_V1",
                              "UACRF_OBSERVATION_V2"
                            ]
                          },
                          "occurred_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "received_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "expires_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "artifact_verified_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "object_ref": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048,
                            "pattern": "\\S"
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "quality": {
                            "const": "OBSERVATION_ONLY"
                          },
                          "observation": {
                            "$ref": "../runtime/src/main/resources/contracts/evidence-observation.schema.json"
                          }
                        },
                        "required": [
                          "id",
                          "service_id",
                          "source_id",
                          "source_event_id",
                          "schema_version",
                          "occurred_at",
                          "received_at",
                          "expires_at",
                          "artifact_verified_at",
                          "object_ref",
                          "digest",
                          "quality",
                          "observation"
                        ]
                      }
                    },
                    "next_cursor": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "coverage": {
                      "const": "AUTHORIZED_VISIBLE_SCOPE_ONLY"
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "coverage"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evidence/events:inline": {
      "post": {
        "operationId": "evidence-inline-submit",
        "summary": "evidence inline submit",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Durably accepted, not domain completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/CommandReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Guarded failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "service_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  "source_event_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  "occurred_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "kind": {
                    "enum": [
                      "METRIC",
                      "CONFIGURATION",
                      "AGENT_EXECUTION"
                    ]
                  },
                  "data": {
                    "type": "object"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "service_id",
                  "source_event_id",
                  "occurred_at",
                  "kind",
                  "data",
                  "id",
                  "expires_at"
                ],
                "title": "UACRF observation, Version 1.0",
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "METRIC"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "data": {
                          "anyOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "metric": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 200,
                                  "pattern": "\\S"
                                },
                                "value": {
                                  "type": "number",
                                  "minimum": -1e+100,
                                  "maximum": 1e+100
                                },
                                "unit": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 80,
                                  "pattern": "\\S"
                                },
                                "window_start": {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                "window_end": {
                                  "type": "string",
                                  "format": "date-time"
                                }
                              },
                              "required": [
                                "metric",
                                "value",
                                "unit",
                                "window_start",
                                "window_end"
                              ]
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "metric": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 200,
                                  "pattern": "\\S"
                                },
                                "value": {
                                  "type": "number",
                                  "minimum": -1e+100,
                                  "maximum": 1e+100
                                },
                                "unit": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 80,
                                  "pattern": "\\S"
                                },
                                "window_start": {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                "window_end": {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                "measurement_kind": {
                                  "enum": [
                                    "THRESHOLD",
                                    "PERCENTILE",
                                    "RATIO",
                                    "RECOVERY_TIME",
                                    "OUTCOME"
                                  ]
                                },
                                "measurement_ref": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 1000,
                                  "pattern": "\\S"
                                },
                                "percentile": {
                                  "anyOf": [
                                    {
                                      "type": "number",
                                      "exclusiveMinimum": 0,
                                      "maximum": 100
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "metric",
                                "value",
                                "unit",
                                "window_start",
                                "window_end",
                                "measurement_kind",
                                "measurement_ref",
                                "percentile"
                              ],
                              "allOf": [
                                {
                                  "if": {
                                    "properties": {
                                      "measurement_kind": {
                                        "const": "PERCENTILE"
                                      }
                                    }
                                  },
                                  "then": {
                                    "properties": {
                                      "percentile": {
                                        "type": "number",
                                        "exclusiveMinimum": 0,
                                        "maximum": 100
                                      }
                                    }
                                  },
                                  "else": {
                                    "properties": {
                                      "percentile": {
                                        "type": "null"
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "CONFIGURATION"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "resource_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "\\S"
                            },
                            "configuration_digest": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
                            "source_version": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "\\S"
                            },
                            "source_checked_at": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "change_type": {
                              "enum": [
                                "SNAPSHOT",
                                "CHANGED",
                                "DELETED"
                              ]
                            }
                          },
                          "required": [
                            "resource_id",
                            "configuration_digest",
                            "source_version",
                            "source_checked_at",
                            "change_type"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "AGENT_EXECUTION"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "profile_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "\\S"
                            },
                            "execution_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "\\S"
                            },
                            "event_type": {
                              "enum": [
                                "OBSERVATION",
                                "FAILURE",
                                "TIMEOUT",
                                "COMPLETION"
                              ]
                            },
                            "event_sequence": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9223372036854775807
                            }
                          },
                          "required": [
                            "profile_id",
                            "execution_id",
                            "event_type",
                            "event_sequence"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
