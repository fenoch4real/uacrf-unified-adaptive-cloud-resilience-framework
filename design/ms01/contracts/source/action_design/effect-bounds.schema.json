{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UACRF effect-bounds.schema.json Version 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "UACRF_ACTION_BOUNDS_V1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "case_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
    },
    "declared_effect": {
      "enum": [
        "READ_ONLY",
        "MUTATING"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "expected_effect": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "provider": {
            "enum": [
              "AWS",
              "AZURE",
              "GCP",
              "AGENT_RUNTIME"
            ]
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        },
        "required": [
          "resource_id",
          "provider",
          "region"
        ]
      }
    },
    "maximum_changed_resources": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "maximum_cost_usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000,
      "multipleOf": 1e-06
    },
    "allowed_changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "property": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "maximum_absolute_change": {
            "type": "number",
            "minimum": 0
          },
          "allowed_values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "resource_id",
          "property"
        ],
        "anyOf": [
          {
            "required": [
              "maximum_absolute_change"
            ]
          },
          {
            "required": [
              "allowed_values"
            ]
          }
        ]
      }
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^artifact:sha256:[a-f0-9]{64}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "reference",
          "digest"
        ]
      }
    },
    "reversibility": {
      "enum": [
        "REVERSIBLE",
        "COMPENSATABLE",
        "IRREVERSIBLE"
      ]
    },
    "recovery_path": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^artifact:sha256:[a-f0-9]{64}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "reference",
            "digest"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "validation_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^artifact:sha256:[a-f0-9]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "reference",
        "digest"
      ]
    },
    "compensation_plan": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^artifact:sha256:[a-f0-9]{64}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "reference",
            "digest"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol",
    "candidate_id",
    "tenant_id",
    "environment_id",
    "service_id",
    "case_id",
    "case_digest",
    "policy_version_id",
    "producer_id",
    "actor_id",
    "created_at",
    "expires_at",
    "action_kind",
    "declared_effect",
    "intent",
    "expected_effect",
    "targets",
    "maximum_changed_resources",
    "maximum_cost_usd",
    "allowed_changes",
    "prerequisites",
    "reversibility",
    "recovery_path",
    "validation_plan",
    "compensation_plan"
  ]
}
