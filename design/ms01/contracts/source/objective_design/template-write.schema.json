{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publish administrator template version",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "template_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "definition": {
      "$ref": "./template-definition.schema.json"
    }
  },
  "required": [
    "template_id",
    "expected_revision",
    "reason",
    "definition"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "template_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "expected_revision": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ]
}
