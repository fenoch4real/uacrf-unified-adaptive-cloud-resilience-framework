    "/v1/customer-journeys/{id}/capabilities/{link_id}:update": {
      "post": {
        "operationId": "journey_link_update",
        "summary": "Update a journey relationship",
        "description": "PROPOSED. Server derives current tenant/environment/actor; requires scoped catalogue write and source/target visibility. Lock the active link, compare expected_revision, preserve original identity and endpoints, validate permitted role/type and step membership, then atomically append relationship history and audit/outbox with the guarded change. Retiring excludes the link from current projections but retains its history. No access or runtime authority is granted. Reusing the same idempotency key/request returns the original receipt; changed payload returns 409. Runtime revision 2 uses a synchronous atomic metadata transaction and returns 200 after commit. It does not use the asynchronous 202 command-admission receipt.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          },
          {
            "in": "path",
            "name": "link_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
