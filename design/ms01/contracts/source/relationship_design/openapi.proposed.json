    "/v1/commands/{id}": {
      "get": {
        "operationId": "read_command_status",
        "summary": "Read an authorized durable command and retained result reference",
        "description": "PROPOSED. Read existing command metadata under current actor/delegation and target permissions. Hide inaccessible command existence. Completion means operation processing completed, not policy ALLOW, qualified evidence or recovered health. Validate result artifact digest before disclosure. Result metadata is retained in command.payload by the controlled worker; that worker is not supplied.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized command metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "command_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "operation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "status": {
                      "enum": [
                        "PENDING",
                        "PROCESSING",
                        "SUCCEEDED",
                        "FAILED",
                        "BLOCKED"
                      ]
                    },
                    "result_ref": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "result_digest": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "error": {
                      "anyOf": [
                        {
                          "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "domain_completion": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "command_id",
                    "operation",
                    "status",
                    "result_ref",
                    "result_digest",
                    "error",
                    "domain_completion"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "enum": [
                              "PENDING",
                              "PROCESSING"
                            ]
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "domain_completion": {
                            "const": false
                          },
                          "result_ref": {
                            "type": "null"
                          },
                          "result_digest": {
                            "type": "null"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "SUCCEEDED"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "domain_completion": {
                            "const": true
                          },
                          "result_ref": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048,
                            "pattern": "\\S"
                          },
                          "result_digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "error": {
                            "type": "null"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
