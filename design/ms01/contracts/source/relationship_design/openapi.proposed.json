            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  },
                  "step_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "criticality": {
                    "enum": [
                      "REQUIRED",
                      "OPTIONAL",
                      "UNKNOWN"
                    ]
                  }
                },
                "required": [
                  "expected_revision",
                  "reason",
                  "step_id",
                  "criticality"
                ]
              }
