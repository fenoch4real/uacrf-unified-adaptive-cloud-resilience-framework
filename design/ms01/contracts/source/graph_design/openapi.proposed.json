                    "runtime_verification": {
                      "const": "NOT_ESTABLISHED"
                    },
                    "affected_nodes": {
                      "type": "array",
                      "maxItems": 1000,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "witnesses": {
                      "type": "array",
                      "maxItems": 1000,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "node_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "node_path": {
                            "type": "array",
                            "maxItems": 9,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          },
                          "edge_path": {
                            "type": "array",
                            "maxItems": 8,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        "required": [
                          "node_id",
                          "node_path",
                          "edge_path"
                        ]
                      }
                    },
                    "completeness": {
                      "enum": [
                        "ACCEPTED_REVISION_ONLY",
                        "INCOMPLETE"
                      ]
                    },
                    "decision": {
                      "const": "DIAGNOSTIC_ONLY"
                    }
                  },
                  "required": [
                    "graph_revision_id",
                    "digest",
                    "source_watermark",
                    "state",
                    "runtime_verification",
                    "affected_nodes",
                    "witnesses",
