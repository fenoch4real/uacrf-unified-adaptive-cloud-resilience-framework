                }
              }
            }
          },
          "404": {
            "description": "Restrictive response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Restrictive response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Restrictive response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Restrictive response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api_reference/core.openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-implementation-status": "IMPLEMENTED_DUAL_DATABASE_LOCAL_NOT_LIVE_ACCEPTED"
      }
    },
    "/v1/graphs/revisions/{revision}/impact": {
      "get": {
        "operationId": "graph_runtime_impact",
