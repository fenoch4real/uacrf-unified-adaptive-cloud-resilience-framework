{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "source_watermark": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "canonical_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "qualification_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "workload_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "workload_kind": {
            "enum": [
              "SERVICE",
              "AGENT",
              "RESOURCE"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "canonical_id",
          "label",
          "qualification_id",
          "expires_at"
        ]
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 75000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relationship_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "qualification_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "relationship_id",
          "source_id",
          "target_id",
          "type",
          "qualification_id",
          "confidence",
          "valid_from",
          "expires_at"
        ]
      }
    }
  },
  "required": [
    "revision_id",
    "service_id",
    "object_ref",
    "source_watermark",
    "nodes",
    "edges"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
