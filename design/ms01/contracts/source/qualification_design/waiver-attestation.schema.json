{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uacrf:qualification-waiver-attestation:v1",
  "title": "Signed qualification waiver payload, Version 1.0",
  "description": "Payload structure only. RS256 signature, pinned issuer/audience/key, current time, maximum 24-hour signature lifetime and exact retained business digest must also be verified.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "jti": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "iat": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "nbf": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "exp": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "purpose": {
      "const": "qualification-waiver"
    },
    "waiver_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "waiver_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    }
  },
  "required": [
    "iss",
    "aud",
    "sub",
    "jti",
    "tenant_id",
    "environment_id",
    "iat",
    "nbf",
    "exp",
    "purpose",
    "waiver_id",
    "waiver_digest",
    "approved_by"
  ]
}
