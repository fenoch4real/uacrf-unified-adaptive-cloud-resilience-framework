{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "event_sequence",
    "suite_digest",
    "verdict",
    "object_ref",
    "expires_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "suite_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
