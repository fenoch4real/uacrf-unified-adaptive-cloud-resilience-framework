{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_id",
    "expected_revision"
  ],
  "properties": {
    "version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
