{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version_number",
    "digest",
    "object_ref",
    "manifest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "version_number": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "manifest": {
      "$ref": "workload-version.schema.json"
    }
  }
}
