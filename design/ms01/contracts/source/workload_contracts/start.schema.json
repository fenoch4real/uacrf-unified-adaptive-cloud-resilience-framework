{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version_id",
    "input_digest",
    "steps",
    "tokens",
    "cost",
    "deadline"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "steps": {
      "type": "integer",
      "minimum": 1
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "type": "integer",
      "minimum": 0
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  }
}
