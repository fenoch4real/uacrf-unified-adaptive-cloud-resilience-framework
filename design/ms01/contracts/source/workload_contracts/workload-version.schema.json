{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uacrf:workload-version:1.0",
  "title": "Protected agent workload version manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instructions_digest",
    "model_ref",
    "knowledge_refs",
    "tools",
    "memory_namespace",
    "evaluation_suite_ref",
    "recovery_rules_ref",
    "runtime_build",
    "data_policy_ref",
    "handoff_ref",
    "limits"
  ],
  "properties": {
    "instructions_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "knowledge_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_ref",
          "schema_digest",
          "effects",
          "timeout_ms"
        ],
        "properties": {
          "tool_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "schema_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "READ",
                "WRITE",
                "EXECUTE"
              ]
            }
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          }
        }
      }
    },
    "memory_namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "evaluation_suite_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "recovery_rules_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "runtime_build": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "data_policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "handoff_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "tokens",
        "cost_units",
        "duration_seconds"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "cost_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  }
}
