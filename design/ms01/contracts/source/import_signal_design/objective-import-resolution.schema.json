{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "objective import resolution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "expected_import_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_local_revision": {
      "type": "integer",
      "minimum": 0
    },
    "choice": {
      "enum": [
        "KEEP_LOCAL",
        "PROPOSE_SOURCE",
        "DETACH_SOURCE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    }
  },
  "required": [
    "expected_import_revision",
    "expected_local_revision",
    "choice",
    "reason"
  ]
}
