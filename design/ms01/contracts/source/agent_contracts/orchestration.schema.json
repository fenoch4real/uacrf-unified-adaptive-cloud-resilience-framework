{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uacrf:1.0:OrchestrationRun",
  "title": "OrchestrationRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "case_id",
    "tenant_id",
    "environment_id",
    "service_id",
    "context_digest",
    "corpus_digest",
    "graph_digest",
    "policy_digest",
    "workflow_version",
    "prompt_version",
    "model_config_ref",
    "authority_tier",
    "state",
    "deadline",
    "max_calls",
    "max_tokens",
    "max_cost_units",
    "assignments"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "corpus_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "graph_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "model_config_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_tier": {
      "enum": [
        "A0",
        "A1",
        "A2"
      ]
    },
    "state": {
      "enum": [
        "CREATED",
        "CONTEXT_SEALED",
        "RUNNING",
        "COLLECTING",
        "HUMAN_REVIEW",
        "BLOCKED",
        "CANCELLED",
        "TIMED_OUT",
        "COMPLETED"
      ]
    },
    "deadline": {
      "type": "integer"
    },
    "max_calls": {
      "type": "integer",
      "minimum": 1
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "max_cost_units": {
      "type": "integer",
      "minimum": 0
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:uacrf:1.0:Assignment",
        "title": "Assignment",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment_id",
          "role",
          "required",
          "attempt_id",
          "grant_ref",
          "tools",
          "output_schema_ref",
          "deadline"
        ],
        "properties": {
          "assignment_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "grant_ref": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "output_schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "deadline": {
            "type": "integer"
          }
        }
      }
    }
  }
}
