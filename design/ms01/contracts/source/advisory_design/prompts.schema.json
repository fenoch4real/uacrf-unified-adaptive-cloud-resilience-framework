{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "UACRF_ADVISORY_PROMPTS_V1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instructions_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "instructions_digest",
          "text"
        ]
      }
    }
  },
  "required": [
    "protocol",
    "tenant_id",
    "environment_id",
    "prompts"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
