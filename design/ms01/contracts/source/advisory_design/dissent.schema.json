{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "UACRF_ADVISORY_DISSENT_V1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "attempt_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "blocking": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "citations": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "chunk_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "excerpt_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "item_id",
          "version",
          "chunk_id",
          "source_digest",
          "excerpt_digest"
        ]
      }
    }
  },
  "required": [
    "protocol",
    "tenant_id",
    "environment_id",
    "service_id",
    "run_id",
    "assignment_id",
    "attempt_key",
    "producer_id",
    "context_digest",
    "id",
    "blocking",
    "reason",
    "citations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
