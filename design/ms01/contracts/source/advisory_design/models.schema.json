{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "UACRF_ADVISORY_MODELS_V1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "engine": {
            "const": "HTTP_JSON_ADVISORY_V1"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "maximum_output_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "maximum_cost_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        },
        "required": [
          "model_ref",
          "engine",
          "timeout_seconds",
          "maximum_output_tokens",
          "maximum_cost_units"
        ]
      }
    }
  },
  "required": [
    "protocol",
    "tenant_id",
    "environment_id",
    "models"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
