{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UACRF validation plan Version 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "UACRF_VALIDATION_PLAN_V1"
    },
    "purpose": {
      "const": "VALIDATION_PLAN"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "case_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "author_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          },
          "layer": {
            "enum": [
              "CONFIGURATION",
              "DEPENDENCY",
              "SERVICE",
              "CUSTOMER_JOURNEY",
              "AGENT",
              "TELEMETRY"
            ]
          },
          "target_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "mandatory": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            }
          },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "policy_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
              },
              "policy_revision": {
                "type": "integer",
                "minimum": 1
              },
              "policy_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "requirement_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
              },
              "accepted_qualification_state": {
                "const": "QUALIFIED"
              }
            },
            "required": [
              "policy_id",
              "policy_revision",
              "policy_digest",
              "requirement_id",
              "accepted_qualification_state"
            ]
          },
          "expectation": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "METRIC"
                  },
                  "metric": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  "measurement_kind": {
                    "enum": [
                      "THRESHOLD",
                      "PERCENTILE",
                      "RATIO",
                      "RECOVERY_TIME",
                      "OUTCOME"
                    ]
                  },
                  "measurement_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  "percentile": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "comparison": {
                    "enum": [
                      "AT_MOST",
                      "AT_LEAST",
                      "EQUAL"
                    ]
                  },
                  "target": {
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "metric",
                  "unit",
                  "measurement_kind",
                  "measurement_ref",
                  "percentile",
                  "comparison",
                  "target"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "CONFIGURATION"
                  },
                  "resource_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  "configuration_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "resource_id",
                  "configuration_digest"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "AGENT_EXECUTION"
                  },
                  "profile_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
                  },
                  "event_type": {
                    "enum": [
                      "OBSERVATION",
                      "COMPLETION"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "profile_id",
                  "event_type"
                ]
              }
            ]
          },
          "stable_window_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "poll_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "maximum_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maximum_age_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        },
        "required": [
          "id",
          "layer",
          "target_ref",
          "mandatory",
          "depends_on",
          "probe",
          "expectation",
          "stable_window_seconds",
          "poll_seconds",
          "timeout_seconds",
          "maximum_attempts",
          "maximum_age_seconds"
        ]
      }
    },
    "maximum_duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "maximum_total_probes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "compensation_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^artifact:sha256:[a-f0-9]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "reference",
        "digest"
      ]
    },
    "escalation_owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "maximum_parallel_checks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "protocol",
    "purpose",
    "id",
    "tenant_id",
    "environment_id",
    "service_id",
    "case_id",
    "case_digest",
    "candidate_id",
    "author_id",
    "created_at",
    "expires_at",
    "checks",
    "maximum_duration_seconds",
    "maximum_total_probes",
    "compensation_plan",
    "escalation_owner_id",
    "reason",
    "maximum_parallel_checks"
  ]
}
