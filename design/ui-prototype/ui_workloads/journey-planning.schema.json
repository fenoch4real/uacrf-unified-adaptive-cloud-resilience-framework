{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ephemeral journey planning and composition draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "outcome",
    "owner_id",
    "steps",
    "step_capabilities",
    "confirmed"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "\\S"
      }
    },
    "step_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_position",
          "services",
          "agents"
        ],
        "properties": {
          "step_position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "services": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          },
          "agents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "confirmed": {
      "type": "boolean"
    }
  }
}
