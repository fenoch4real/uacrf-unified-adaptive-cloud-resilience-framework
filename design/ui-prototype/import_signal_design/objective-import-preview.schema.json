{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "objective import preview",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "external_objective_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "target_workload_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "mapping_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_local_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "connection_id",
    "external_objective_id",
    "target_workload_id",
    "mapping_revision",
    "expected_local_revision"
  ]
}
