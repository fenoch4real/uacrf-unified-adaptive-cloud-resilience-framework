# Database admin credentials are for PostgreSQL administration only;
# services connect with the separate *_DB_USER and *_DB_PASSWORD values.
IDENTITY_DB_NAME=uacrf_identity
IDENTITY_DB_ADMIN_USER=uacrf_identity_admin
IDENTITY_DB_ADMIN_PASSWORD=replace-with-a-random-identity-database-admin-password
IDENTITY_DB_USER=uacrf_identity_runtime
IDENTITY_DB_PASSWORD=replace-with-a-random-local-password
CATALOG_DB_NAME=uacrf_catalog
CATALOG_DB_ADMIN_USER=uacrf_catalog_admin
CATALOG_DB_ADMIN_PASSWORD=replace-with-a-random-catalog-database-admin-password
CATALOG_DB_USER=uacrf_catalog_runtime
CATALOG_DB_PASSWORD=replace-with-a-different-random-local-password
CONNECTIONS_DB_NAME=uacrf_connections
CONNECTIONS_DB_ADMIN_USER=uacrf_connections_admin
CONNECTIONS_DB_ADMIN_PASSWORD=replace-with-a-random-connections-database-admin-password
CONNECTIONS_DB_USER=uacrf_connections_runtime
CONNECTIONS_DB_PASSWORD=replace-with-a-third-random-local-password
EVIDENCE_DB_NAME=uacrf_evidence
EVIDENCE_DB_ADMIN_USER=uacrf_evidence_admin
EVIDENCE_DB_ADMIN_PASSWORD=replace-with-a-random-evidence-database-admin-password
EVIDENCE_DB_USER=uacrf_evidence_runtime
EVIDENCE_DB_PASSWORD=replace-with-a-fourth-random-local-password
OBJECTIVES_DB_NAME=uacrf_objectives
OBJECTIVES_DB_ADMIN_USER=uacrf_objectives_admin
OBJECTIVES_DB_ADMIN_PASSWORD=replace-with-a-random-objectives-database-admin-password
OBJECTIVES_DB_USER=uacrf_objectives_runtime
OBJECTIVES_DB_PASSWORD=replace-with-a-fifth-random-local-password
TOPOLOGY_DB_NAME=uacrf_topology
TOPOLOGY_DB_ADMIN_USER=uacrf_topology_admin
TOPOLOGY_DB_ADMIN_PASSWORD=replace-with-a-random-topology-database-admin-password
TOPOLOGY_DB_USER=uacrf_topology_runtime
TOPOLOGY_DB_PASSWORD=replace-with-a-sixth-random-local-password
ASSESSMENT_DB_NAME=uacrf_assessment
ASSESSMENT_DB_ADMIN_USER=uacrf_assessment_admin
ASSESSMENT_DB_ADMIN_PASSWORD=replace-with-a-random-assessment-database-admin-password
ASSESSMENT_DB_USER=uacrf_assessment_app
ASSESSMENT_DB_PASSWORD=replace-with-a-seventh-random-local-password
KNOWLEDGE_DB_NAME=uacrf_knowledge
KNOWLEDGE_DB_ADMIN_USER=uacrf_knowledge_admin
KNOWLEDGE_DB_ADMIN_PASSWORD=replace-with-a-random-knowledge-database-admin-password
KNOWLEDGE_DB_USER=uacrf_knowledge_runtime
KNOWLEDGE_DB_PASSWORD=replace-with-an-eighth-random-local-password
DECISION_GOVERNANCE_DB_NAME=uacrf_decision_governance
DECISION_GOVERNANCE_DB_ADMIN_USER=uacrf_decision_governance_admin
DECISION_GOVERNANCE_DB_ADMIN_PASSWORD=replace-with-a-random-decision-governance-database-admin-password
DECISION_GOVERNANCE_DB_USER=uacrf_decision_governance_runtime
DECISION_GOVERNANCE_DB_PASSWORD=replace-with-a-ninth-random-local-password
# Optional S10 reviewer public-key trust set (single-line JSON, public keys only). Empty disables
# policy approvals; see services/decision-governance/README.md. Example:
# UACRF_POLICY_TRUST_SET_JSON={"revision":1,"keys":[{"kid":"reviewer-key-1","algorithm":"RS256","public_key_base64":"<base64 X.509 SubjectPublicKeyInfo DER>","tenant_id":"tenant-1","environment_id":"environment-1","service_id":"service-1","reviewer_id":"reviewer-1"}]}
UACRF_POLICY_TRUST_SET_JSON=

# Optional S04 qualification-waiver reviewer trust set (single-line JSON, public keys only).
# An empty value disables approval; key entries are bound to an exact tenant/environment/service/reviewer.
# Keep signer private keys outside S04 and source control; increment revision for trust changes.
# UACRF_QUALIFICATION_WAIVER_TRUST_SET_JSON={"revision":1,"issuer":"https://waiver-authority.example","audience":"uacrf-evidence","keys":[{"kid":"reviewer-key-1","algorithm":"RS256","public_key_base64":"<base64 X.509 SubjectPublicKeyInfo DER>","tenant_id":"tenant-1","environment_id":"environment-1","service_id":"service-1","reviewer_id":"reviewer-1"}]}
UACRF_QUALIFICATION_WAIVER_TRUST_SET_JSON=

# Development-only Keycloak credentials; replace both passwords before startup.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-keycloak-admin-password
KEYCLOAK_LOCAL_ADMIN_PASSWORD=replace-with-a-local-uacrf-admin-password
KEYCLOAK_DIRECTORY_CLIENT_SECRET=replace-with-a-random-directory-client-secret
KEYCLOAK_S03_PUBLISHER_CLIENT_SECRET=replace-with-a-random-s03-publisher-secret
KEYCLOAK_S07_EVALUATOR_CLIENT_SECRET=replace-with-a-random-s07-evaluator-secret
KEYCLOAK_S08_RETRIEVER_CLIENT_SECRET=replace-with-a-random-s08-retriever-secret
KEYCLOAK_S05_OBJECTIVE_REVIEWER_CLIENT_SECRET=replace-with-a-random-s05-objective-reviewer-secret
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/uacrf
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/uacrf/protocol/openid-connect/certs
# Optional web-client endpoints when its browser-visible issuer differs from
# the Keycloak address reachable by the web container.
# UACRF_OIDC_AUTHORIZATION_URI=http://localhost:8180/realms/uacrf/protocol/openid-connect/auth
# UACRF_OIDC_TOKEN_URI=http://keycloak:8080/realms/uacrf/protocol/openid-connect/token
# UACRF_OIDC_JWK_SET_URI=http://keycloak:8080/realms/uacrf/protocol/openid-connect/certs
# UACRF_OIDC_USERINFO_URI=http://keycloak:8080/realms/uacrf/protocol/openid-connect/userinfo

# S01 signs with an RSA private key; configure it only in the S01 process.
# S01 and S02 both need the matching X.509 public key and key id.
# Generate at least a 2048-bit RSA key pair and Base64-encode the PKCS#8
# private key and X.509 public key. Keep all generated keys out of source control.
# UACRF_DELEGATION_PRIVATE_KEY_BASE64=
UACRF_DELEGATION_PUBLIC_KEY_BASE64=replace-with-base64-x509-public-key
UACRF_DELEGATION_KEY_ID=local-dev-key-1

# S02 signs owner receipts with a key separate from the S01 delegation key.
# Keep the private key in S02 only; configure the matching public key in S06.
# Generate a separate RSA-2048 key pair and Base64-encode PKCS#8 private and
# X.509 public key bytes. Keep generated key material out of source control.
UACRF_S02_OWNER_RECEIPT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-private-key
UACRF_S02_OWNER_RECEIPT_PUBLIC_KEY_BASE64=replace-with-base64-x509-public-key
UACRF_S02_OWNER_RECEIPT_KEY_ID=s02-owner-local-1
UACRF_TOPOLOGY_S02_PUBLIC_KEY_BASE64=replace-with-the-same-base64-x509-public-key
UACRF_TOPOLOGY_S02_KEY_ID=s02-owner-local-1

# Optional first-start identity bootstrap. Keep disabled except during a
# deliberate, operator-controlled initialization with a verified Keycloak subject.
IDENTITY_BOOTSTRAP_ENABLED=false
IDENTITY_BOOTSTRAP_PROVIDER_ID=keycloak-local
IDENTITY_BOOTSTRAP_PROVIDER_NAME=Local Keycloak
IDENTITY_BOOTSTRAP_ISSUER=http://localhost:8180/realms/uacrf
IDENTITY_BOOTSTRAP_TENANT_ID=local-dev
IDENTITY_BOOTSTRAP_TENANT_NAME=Local Development
IDENTITY_BOOTSTRAP_ENVIRONMENT_ID=local
IDENTITY_BOOTSTRAP_ENVIRONMENT_NAME=Local
IDENTITY_BOOTSTRAP_PRINCIPAL_ID=local-admin
IDENTITY_BOOTSTRAP_SUBJECT=00000000-0000-4000-8000-000000000001
IDENTITY_BOOTSTRAP_DISPLAY_NAME=Local Administrator
IDENTITY_BOOTSTRAP_ADMIN_EXPIRES_AT=
IDENTITY_BOOTSTRAP_APPROVER_PRINCIPAL_ID=local-approver
IDENTITY_BOOTSTRAP_APPROVER_SUBJECT=00000000-0000-4000-8000-000000000002
IDENTITY_BOOTSTRAP_APPROVER_DISPLAY_NAME=Local Approver
IDENTITY_BOOTSTRAP_REASON=
IDENTITY_DIRECTORY_ENABLED=false
IDENTITY_DIRECTORY_ISSUER=http://localhost:8180/realms/uacrf
IDENTITY_DIRECTORY_TOKEN_URI=http://localhost:8180/realms/uacrf/protocol/openid-connect/token
IDENTITY_DIRECTORY_USERS_URI=http://localhost:8180/admin/realms/uacrf/users
IDENTITY_DIRECTORY_CLIENT_ID=uacrf-s01-directory
IDENTITY_DIRECTORY_CLIENT_SECRET=
UACRF_OUTBOX_PUBLISHER_ENABLED=false
UACRF_S03_IDENTITY_TOKEN_URL=http://localhost:8180/realms/uacrf/protocol/openid-connect/token
UACRF_S03_CLIENT_ID=uacrf-s03-publisher
UACRF_S03_CLIENT_SECRET=
UACRF_S03_S01_DELEGATION_URL=http://localhost:8082/internal/v1/delegations
# Keep collection disabled until its dedicated S03 system client and provider are approved.
UACRF_COLLECTION_RUNNER_ENABLED=false
UACRF_COLLECTION_RUNNER_INTERVAL_MS=60000
UACRF_COLLECTION_RUNNER_LEASE_MS=300000
UACRF_COLLECTION_RUNNER_BATCH_SIZE=10
UACRF_COLLECTION_RUNNER_MAX_OBSERVATIONS=100
UACRF_S03_COLLECTION_TOKEN_URL=http://localhost:8180/realms/uacrf/protocol/openid-connect/token
UACRF_S03_COLLECTION_CLIENT_ID=uacrf-s03-collector
UACRF_S03_COLLECTION_CLIENT_SECRET=
UACRF_S03_COLLECTION_DELEGATION_URL=http://localhost:8082/internal/v1/delegations
UACRF_S03_OBSERVATION_BASE_URL=http://localhost:8085
UACRF_ASSESSMENT_RECEIPTS_ENABLED=false
UACRF_ASSESSMENT_RECEIPTS_TOKEN_URL=http://localhost:8180/realms/uacrf/protocol/openid-connect/token
UACRF_ASSESSMENT_RECEIPTS_CLIENT_ID=uacrf-s07-evaluator
UACRF_ASSESSMENT_RECEIPTS_CLIENT_SECRET=
UACRF_ASSESSMENT_RECEIPTS_DELEGATION_URL=http://localhost:8082/internal/v1/delegations
UACRF_ASSESSMENT_RECEIPTS_EVIDENCE_BASE_URL=http://localhost:8086
UACRF_ASSESSMENT_RECEIPTS_OBJECTIVES_BASE_URL=http://localhost:8087
UACRF_ASSESSMENT_RECEIPTS_TOPOLOGY_BASE_URL=http://localhost:8088
# S05 reviewer recheck is disabled by default; local HTTP requires explicit opt-in.
UACRF_OBJECTIVES_REVIEWER_CHECK_ENABLED=false
UACRF_OBJECTIVES_REVIEWER_CHECK_TOKEN_URL=http://127.0.0.1:8180/realms/uacrf/protocol/openid-connect/token
UACRF_OBJECTIVES_REVIEWER_CHECK_IDENTITY_BASE_URL=http://127.0.0.1:8082
# Keep this client secret equal to KEYCLOAK_S05_OBJECTIVE_REVIEWER_CLIENT_SECRET.
UACRF_OBJECTIVES_REVIEWER_CHECK_CLIENT_ID=uacrf-s05-objective-reviewer
UACRF_OBJECTIVES_REVIEWER_CHECK_CLIENT_SECRET=
UACRF_OBJECTIVES_REVIEWER_CHECK_ALLOW_LOOPBACK_HTTP=false
UACRF_KNOWLEDGE_CASE_RECEIPTS_ENABLED=false
UACRF_KNOWLEDGE_CASE_RECEIPTS_TOKEN_URL=http://localhost:8180/realms/uacrf/protocol/openid-connect/token
UACRF_KNOWLEDGE_CASE_RECEIPTS_CLIENT_ID=uacrf-s08-retriever
UACRF_KNOWLEDGE_CASE_RECEIPTS_CLIENT_SECRET=
UACRF_KNOWLEDGE_CASE_RECEIPTS_DELEGATION_URL=http://localhost:8082/internal/v1/delegations
UACRF_KNOWLEDGE_CASE_RECEIPTS_ASSESSMENT_BASE_URL=http://localhost:8089
UACRF_EDGE_KNOWLEDGE_BASE_URL=http://localhost:8090
UACRF_EDGE_DECISION_GOVERNANCE_BASE_URL=http://localhost:8091
UACRF_ASSESSMENT_MODELS_ENABLED=false
UACRF_S03_S04_INBOX_URL=http://localhost:8086/internal/v1/inbox/events

# S06 Neo4j projection store (local development only; change the password).
TOPOLOGY_NEO4J_URI=bolt://localhost:55687
TOPOLOGY_NEO4J_USER=neo4j
TOPOLOGY_NEO4J_PASSWORD=replace-with-a-random-topology-neo4j-password
UACRF_TOPOLOGY_PROJECTION_ENABLED=false
