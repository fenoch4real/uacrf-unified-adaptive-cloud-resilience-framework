# Database admin credentials are for PostgreSQL administration only;
# services connect with the separate *_DB_USER and *_DB_PASSWORD values.
IDENTITY_DB_NAME=uacrf_identity
IDENTITY_DB_ADMIN_USER=uacrf_identity_admin
IDENTITY_DB_ADMIN_PASSWORD=replace-with-a-random-identity-database-admin-password
IDENTITY_DB_USER=uacrf_identity_runtime
IDENTITY_DB_PASSWORD=replace-with-a-random-local-password
CATALOG_DB_NAME=uacrf_catalog
CATALOG_DB_ADMIN_USER=uacrf_catalog_admin
CATALOG_DB_ADMIN_PASSWORD=replace-with-a-random-catalog-database-admin-password
CATALOG_DB_USER=uacrf_catalog_runtime
CATALOG_DB_PASSWORD=replace-with-a-different-random-local-password
CONNECTIONS_DB_NAME=uacrf_connections
CONNECTIONS_DB_ADMIN_USER=uacrf_connections_admin
CONNECTIONS_DB_ADMIN_PASSWORD=replace-with-a-random-connections-database-admin-password
CONNECTIONS_DB_USER=uacrf_connections_runtime
CONNECTIONS_DB_PASSWORD=replace-with-a-third-random-local-password

# Development-only Keycloak credentials; replace both passwords before startup.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-keycloak-admin-password
KEYCLOAK_LOCAL_ADMIN_PASSWORD=replace-with-a-local-uacrf-admin-password
KEYCLOAK_DIRECTORY_CLIENT_SECRET=replace-with-a-random-directory-client-secret
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/uacrf
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/uacrf/protocol/openid-connect/certs
# Optional web-client endpoints when its browser-visible issuer differs from
# the Keycloak address reachable by the web container.
# UACRF_OIDC_AUTHORIZATION_URI=http://localhost:8180/realms/uacrf/protocol/openid-connect/auth
# UACRF_OIDC_TOKEN_URI=http://keycloak:8080/realms/uacrf/protocol/openid-connect/token
# UACRF_OIDC_JWK_SET_URI=http://keycloak:8080/realms/uacrf/protocol/openid-connect/certs
# UACRF_OIDC_USERINFO_URI=http://keycloak:8080/realms/uacrf/protocol/openid-connect/userinfo

# S01 signs with an RSA private key; configure it only in the S01 process.
# S01 and S02 both need the matching X.509 public key and key id.
# Generate at least a 2048-bit RSA key pair and Base64-encode the PKCS#8
# private key and X.509 public key. Keep all generated keys out of source control.
# UACRF_DELEGATION_PRIVATE_KEY_BASE64=
UACRF_DELEGATION_PUBLIC_KEY_BASE64=replace-with-base64-x509-public-key
UACRF_DELEGATION_KEY_ID=local-dev-key-1

# Optional first-start identity bootstrap. Keep disabled except during a
# deliberate, operator-controlled initialization with a verified Keycloak subject.
IDENTITY_BOOTSTRAP_ENABLED=false
IDENTITY_BOOTSTRAP_PROVIDER_ID=keycloak-local
IDENTITY_BOOTSTRAP_PROVIDER_NAME=Local Keycloak
IDENTITY_BOOTSTRAP_ISSUER=http://localhost:8180/realms/uacrf
IDENTITY_BOOTSTRAP_TENANT_ID=local-dev
IDENTITY_BOOTSTRAP_TENANT_NAME=Local Development
IDENTITY_BOOTSTRAP_ENVIRONMENT_ID=local
IDENTITY_BOOTSTRAP_ENVIRONMENT_NAME=Local
IDENTITY_BOOTSTRAP_PRINCIPAL_ID=local-admin
IDENTITY_BOOTSTRAP_SUBJECT=00000000-0000-4000-8000-000000000001
IDENTITY_BOOTSTRAP_DISPLAY_NAME=Local Administrator
IDENTITY_BOOTSTRAP_ADMIN_EXPIRES_AT=
IDENTITY_BOOTSTRAP_APPROVER_PRINCIPAL_ID=local-approver
IDENTITY_BOOTSTRAP_APPROVER_SUBJECT=00000000-0000-4000-8000-000000000002
IDENTITY_BOOTSTRAP_APPROVER_DISPLAY_NAME=Local Approver
IDENTITY_BOOTSTRAP_REASON=
IDENTITY_DIRECTORY_ENABLED=false
IDENTITY_DIRECTORY_ISSUER=http://localhost:8180/realms/uacrf
IDENTITY_DIRECTORY_TOKEN_URI=http://localhost:8180/realms/uacrf/protocol/openid-connect/token
IDENTITY_DIRECTORY_USERS_URI=http://localhost:8180/admin/realms/uacrf/users
IDENTITY_DIRECTORY_CLIENT_ID=uacrf-s01-directory
IDENTITY_DIRECTORY_CLIENT_SECRET=
